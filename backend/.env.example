APP_NAME="Magwood Herd Records API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=warning
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Local demo only. Bind HerdRepository to the team's database adapter for production.
HERD_STORE=demo-file
HERD_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Reserved for the database teammate; no schema or adapter is installed yet.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magwood
DB_USERNAME=
DB_PASSWORD=
