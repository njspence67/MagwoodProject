<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="Herd API"><directory>tests/Feature</directory><directory>tests/Unit</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
    </php>
</phpunit>
